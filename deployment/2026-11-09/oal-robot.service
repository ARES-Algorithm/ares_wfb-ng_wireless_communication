[Unit]
Description=Omni Arm Link robot telemetry and control receiver
After=network.target
[Service]
WorkingDirectory=/home/arespi/omni-arm-link
ExecStart=/home/arespi/omni-arm-link/build/oal_robot --config /home/arespi/omni-arm-link/config/link.conf --no-measure-latency --print-rate 1
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
