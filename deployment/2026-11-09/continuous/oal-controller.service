ExecStart=/home/gracekite/Documents/MyFiles/RC_Projects/AlgoWorkspace-27/omni-arm-link/build/oal_controller --config /home/gracekite/Documents/MyFiles/RC_Projects/AlgoWorkspace-27/omni-arm-link/config/link.conf --no-auto-motion --no-measure-latency --print-rate 0 --log-level warn
